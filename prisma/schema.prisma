// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Empresa {
  id            Int            @id @default(autoincrement())
  nome          String
  cnpj          String         @unique
  telefone      String?
  ativa         Boolean        @default(true)
  criadoEm      DateTime       @default(now())
  clientes      Cliente[]
  profissionais Profissional[]
  servicos      Servico[]
  agendamentos  Agendamento[]

  @@map("empresas")
}

model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  telefone     String
  criadoEm     DateTime      @default(now())
  empresa      Empresa?      @relation(fields: [empresaId], references: [id])
  empresaId    Int?
  agendamentos Agendamento[]

  @@unique([empresaId, telefone])
  @@map("clientes")
}

model Profissional {
  id              Int               @id @default(autoincrement())
  nome            String
  ativo           Boolean           @default(true)
  empresa         Empresa?          @relation(fields: [empresaId], references: [id])
  empresaId       Int?
  agendamentos    Agendamento[]
  horariosSemanais HorarioSemanal[]
  excecoesAgenda  ExcecaoAgenda[]

  @@map("profissionais")
}

model Servico {
  id           Int                  @id @default(autoincrement())
  nome         String
  preco        Float
  duracaoMin   Int
  empresa      Empresa?             @relation(fields: [empresaId], references: [id])
  empresaId    Int?
  agendamentos AgendamentoServico[]

  @@map("servicos")
}

enum StatusAgendamento {
  AGENDADO
  CONCLUIDO
  CANCELADO
  FALTOU
}

model Agendamento {
  id             Int                  @id @default(autoincrement())
  inicio         DateTime
  fim            DateTime
  status         StatusAgendamento    @default(AGENDADO)
  criadoEm       DateTime             @default(now())
  motivo         String?              @db.VarChar(500)
  idempotencyKey String?              @unique
  payloadHash    String?              @db.Char(64)
  empresa        Empresa?             @relation(fields: [empresaId], references: [id])
  empresaId      Int?
  cliente        Cliente?             @relation(fields: [clienteId], references: [id])
  clienteId      Int?
  profissional   Profissional?        @relation(fields: [profissionalId], references: [id])
  profissionalId Int?
  servicos       AgendamentoServico[]

  @@map("agendamentos")
}

model AgendamentoServico {
  precoCobrado   Float
  duracaoMinutos Int          @default(30)
  servico        Servico?     @relation(fields: [servicoId], references: [id])
  servicoId      Int
  agendamento    Agendamento? @relation(fields: [agendamentoId], references: [id])
  agendamentoId  Int

  @@id([agendamentoId, servicoId])
  @@map("agendamento_servicos")
}

model HorarioSemanal {
  id             Int          @id @default(autoincrement())
  empresaId      Int
  profissionalId Int
  diaSemana      Int
  inicio         String       @db.VarChar(5)
  fim            String       @db.VarChar(5)
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([empresaId, profissionalId, diaSemana])
  @@map("horarios_semanais")
}

model ExcecaoAgenda {
  id             Int                       @id @default(autoincrement())
  empresaId      Int
  profissionalId Int
  data           DateTime                  @db.Date
  fechado        Boolean                   @default(false)
  profissional   Profissional              @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  horarios       ExcecaoHorarioIntervalo[]

  @@unique([profissionalId, data])
  @@index([empresaId, data])
  @@map("excecoes_agenda")
}

model ExcecaoHorarioIntervalo {
  id         Int           @id @default(autoincrement())
  excecaoId  Int
  inicio     String        @db.VarChar(5)
  fim        String        @db.VarChar(5)
  excecao    ExcecaoAgenda @relation(fields: [excecaoId], references: [id], onDelete: Cascade)

  @@index([excecaoId])
  @@map("excecao_horarios")
}
